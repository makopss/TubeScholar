# TubeScholar 환경 변수 설정 템플릿
# 복사하여 .env 파일로 이름을 바꾼 후 사용하세요. (웹 UI 설정 모달에서도 직접 입력 가능)

# Google Gemini API Key (필수: 학습 노트 생성 및 자막 심층 분석에 사용)
GEMINI_API_KEY=

# Groq API Key (선택: 고속 Whisper 음성 인식 STT 사용 시)
GROQ_API_KEY=

# Gemini 모델 설정 (선택: 기본값 gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# 데이터 저장 경로 (선택: 지정하지 않을 경우 기본 data 폴더 또는 사용자 데이터 경로 사용)
# TUBESCHOLAR_DATA_DIR=
